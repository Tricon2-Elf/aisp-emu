#!/usr/bin/env bash
# Format only staged C# / MSBuild files (not the whole repo).
# Enable: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

mapfile -d '' -t staged < <(git diff -z --cached --name-only --diff-filter=ACM)

files=()
for f in "${staged[@]}"; do
  [[ -f "$f" ]] || continue
  if [[ "$f" =~ \.(cs|csx|csproj|props|targets)$ ]]; then
    files+=("$f")
  fi
done

((${#files[@]} == 0)) && exit 0

dotnet tool restore -v q
dotnet tool run csharpier format "${files[@]}"
git add "${files[@]}"
