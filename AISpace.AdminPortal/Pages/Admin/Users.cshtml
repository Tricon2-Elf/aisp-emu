@page "/admin/users"
@model AISpace.AdminPortal.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users"; Layout = "/Pages/Shared/_Layout.cshtml";
}
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="portal-title mb-1">User administration</h1>
        <p class="portal-subtitle mb-0">Review player accounts and game data.</p>
    </div>
    <form method="get" class="d-flex gap-2"><input class="form-control" name="search" value="@Model.Search"
            placeholder="Search username" /><button class="btn btn-primary" type="submit">Search</button></form>
</div>
<section class="character-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">User</th>
                    <th>Characters</th>
                    <th>Robos</th>
                    <th class="pe-3">Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td class="ps-3"><a class="fw-semibold text-decoration-none"
                                href="/admin/users/@user.UserId">@user.Username</a></td>
                        <td>@string.Join(", ", user.CharacterNames)</td>
                        <td>@user.RoboCount</td>
                        <td class="pe-3"><span
                                class="badge @(user.IsBanned ? "text-bg-danger" : "text-bg-success")">@(user.IsBanned ?
                            "Banned" : "Active")</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
<nav class="d-flex gap-2 mt-3">@if (Model.Page > 1)
    {
        <a class="btn btn-outline-light"
            href="?search=@Model.Search&page=@(Model.Page - 1)">Previous</a>
    } @if (Model.HasNextPage)
    {
        <a
            class="btn btn-outline-light" href="?search=@Model.Search&page=@(Model.Page + 1)">Next</a>
    }</nav>
