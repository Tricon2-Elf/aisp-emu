@page "/admin/users/{userId:int}"
@model AISpace.Portal.Pages.Admin.UserDetailModel
@{
    ViewData["Title"] = Model.TargetUser.Username;
    Layout = "/Pages/Shared/_Layout.cshtml";
    const string itemIconBaseUrl = "https://raw.githubusercontent.com/Tricon2-Elf/AI-Space/refs/heads/main/documents/Items/Icons/";
}
<a class="d-inline-block mb-3 text-decoration-none small" href="/admin/users">← Back to users</a>
<header class="account-hero gap-3 mb-4">
    <div>
        <span class="eyebrow">User account</span>
        <h1 class="portal-title mb-1">@Model.TargetUser.Username</h1>
        @if (Model.TargetUser.IsBanned)
        {
            <p class="portal-subtitle mb-0"><span class="status-pill status-banned me-2">Banned</span>@(string.IsNullOrWhiteSpace(Model.TargetUser.BanReason) ? "No reason provided" : Model.TargetUser.BanReason)</p>
        }
        else
        {
            <p class="portal-subtitle mb-0"><span class="status-pill status-active">Active account</span></p>
        }
    </div>
    <div class="admin-actions">
        <button class="btn btn-ghost" type="button" data-modal-target="reset-password-modal">Reset password</button>
        <button class="btn btn-outline-warning" type="button" data-modal-target="kick-user-modal">Kick user</button>
        @if (Model.TargetUser.IsBanned)
        {
            <form method="post" asp-page-handler="Unban">
                <button class="btn btn-outline-success" type="submit">Unban user</button>
            </form>
        }
        else
        {
            <button class="btn btn-danger" type="button" data-modal-target="ban-user-modal">Ban user</button>
        }
    </div>
</header>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert @(Model.StatusIsError ? "alert-danger" : "alert-success")" role="status">@Model.StatusMessage</div>
}
<dialog id="reset-password-modal" class="moderation-modal" aria-labelledby="reset-password-title">
    <form method="post" asp-page-handler="SetPassword">
        <header class="modal-heading">
            <div>
                <span class="eyebrow">Account security</span>
                <h2 id="reset-password-title">Reset @Model.TargetUser.Username's password</h2>
            </div>
            <button class="modal-close" type="button" data-modal-close aria-label="Close">×</button>
        </header>
        <div class="modal-content vstack gap-3">
            <p class="mb-0">Set a new password and disconnect the user from all game servers.</p>
            <div>
                <label class="form-label" for="admin-new-password">New password</label>
                <input id="admin-new-password" class="form-control" type="password" name="newPassword" minlength="8" maxlength="128" autocomplete="new-password" required />
            </div>
            <div>
                <label class="form-label" for="admin-confirm-password">Confirm new password</label>
                <input id="admin-confirm-password" class="form-control" type="password" name="confirmPassword" minlength="8" maxlength="128" autocomplete="new-password" required />
            </div>
        </div>
        <footer class="modal-actions">
            <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
            <button class="btn btn-primary" type="submit">Reset password</button>
        </footer>
    </form>
</dialog>
<dialog id="kick-user-modal" class="moderation-modal" aria-labelledby="kick-user-title">
    <form method="post" asp-page-handler="Kick">
        <header class="modal-heading">
            <div>
                <span class="eyebrow">Moderation action</span>
                <h2 id="kick-user-title">Kick @Model.TargetUser.Username?</h2>
            </div>
            <button class="modal-close" type="button" data-modal-close aria-label="Close">×</button>
        </header>
        <div class="modal-content">
            <p>This immediately disconnects the user from all game servers.</p>
            <label class="form-label" for="kick-reason">Reason <span class="text-secondary fw-normal">(optional)</span></label>
            <textarea id="kick-reason" class="form-control" name="reason" maxlength="256" rows="4" placeholder="Add a note for the moderation log"></textarea>
        </div>
        <footer class="modal-actions">
            <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
            <button class="btn btn-warning" type="submit">Kick user</button>
        </footer>
    </form>
</dialog>
@if (!Model.TargetUser.IsBanned)
{
    <dialog id="ban-user-modal" class="moderation-modal" aria-labelledby="ban-user-title">
        <form method="post" asp-page-handler="Ban">
            <header class="modal-heading">
                <div>
                    <span class="eyebrow">Moderation action</span>
                    <h2 id="ban-user-title">Ban @Model.TargetUser.Username?</h2>
                </div>
                <button class="modal-close" type="button" data-modal-close aria-label="Close">×</button>
            </header>
            <div class="modal-content">
                <p>This bans the account and immediately disconnects the user.</p>
                <label class="form-label" for="ban-reason">Reason <span class="text-secondary fw-normal">(optional)</span></label>
                <textarea id="ban-reason" class="form-control" name="reason" maxlength="256" rows="4" placeholder="Explain why this account is being banned"></textarea>
            </div>
            <footer class="modal-actions">
                <button class="btn btn-ghost" type="button" data-modal-close>Cancel</button>
                <button class="btn btn-danger" type="submit">Ban user</button>
            </footer>
        </form>
    </dialog>
}
<section class="character-card storage-card">
    <span class="eyebrow">Shared</span>
    <div class="profile-facts mb-3 mt-2">
        <div>
            <span class="profile-label">Created</span>
            <strong>@Model.TargetUser.CreatedAt.ToString("MMMM d, yyyy")</strong>
        </div>
        <div>
            <span class="profile-label">Last logged in</span>
            <strong>@(Model.TargetUser.LastLoggedInAt?.ToString("MMMM d, yyyy") ?? "Never")</strong>
        </div>
        <div>
            <span class="profile-label">Dee Points</span>
            <strong>@Model.Account.AiPoints.ToString("N0")</strong>
        </div>
        <div>
            <span class="profile-label">Nico Points</span>
            <strong>@Model.Account.NicoPoints.ToString("N0")</strong>
        </div>
        <div>
            <span class="profile-label">Dee Points (Wardrobe)</span>
            <strong>@Model.Account.StorageDeposit.ToString("N0")</strong>
        </div>
    </div>
    <div class="section-heading">
        <div>
            <h2>Wardrobe storage</h2>
        </div>
        <span class="section-count">@Model.Account.StorageItems.Count item@(Model.Account.StorageItems.Count == 1 ? "" : "s")</span>
    </div>
    @if (Model.Account.StorageItems.Count == 0)
    {
        <p class="empty-state">No items are currently stored here.</p>
    }
    else
    {
        <div class="inventory-list">
            @foreach (var item in Model.Account.StorageItems)
            {
                <div class="inventory-row">
                    <img class="item-icon" src="@(itemIconBaseUrl + item.IconId.ToString("D8") + ".png")" alt="" loading="lazy" />
                    <span class="inventory-name">@item.Name</span>
                    <span class="inventory-quantity">× @item.Quantity</span>
                </div>
            }
        </div>
    }
</section>
@if (Model.Account.Characters.Count == 0)
{
    <section class="character-card">
        <p class="empty-state">This account has no characters.</p>
    </section>
}
else
{
    @foreach (var character in Model.Account.Characters)
    {
        <section class="character-card">
            <header class="character-header">
                <div>
                    <span class="eyebrow">Character</span>
                    <h2>@character.Name</h2>
                </div>
                <dl class="character-location">
                    <div>
                        <dt>Home island</dt>
                        <dd>@character.HomeIslandName</dd>
                    </div>
                    <div>
                        <dt>Current location</dt>
                        <dd>@character.CurrentMapName</dd>
                    </div>
                </dl>
            </header>
            <section class="character-profile">
                <div class="profile-facts">
                    <div>
                        <span class="profile-label">Birthday</span>
                        <strong>@character.Birthdate.ToString("MMMM d, yyyy")</strong>
                    </div>
                    <div>
                        <span class="profile-label">Created</span>
                        <strong>@character.CreatedAt.ToString("MMMM d, yyyy")</strong>
                    </div>
                    <div>
                        <span class="profile-label">Last logged in</span>
                        <strong>@(character.LastLoggedInAt?.ToString("MMMM d, yyyy") ?? "Never")</strong>
                    </div>
                    <div>
                        <span class="profile-label">Blood type</span>
                        <strong>@character.BloodType</strong>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(character.AvatarDescription))
                {
                    <div class="profile-description">
                        <span class="profile-label">About</span>
                        <p>@character.AvatarDescription</p>
                    </div>
                }
                <div class="profile-likes">
                    @foreach (var like in new[] { (character.Like1, character.LikeDescription1), (character.Like2, character.LikeDescription2), (character.Like3, character.LikeDescription3) })
                    {
                        @if (!string.IsNullOrWhiteSpace(like.Item1))
                        {
                            <div class="like-card">
                                <span class="profile-label">Likes</span>
                                <strong>@like.Item1</strong>
                                @if (!string.IsNullOrWhiteSpace(like.Item2))
                                {
                                    <p>@like.Item2</p>
                                }
                            </div>
                        }
                    }
                </div>
            </section>
            <div class="row g-4">
                <section class="col-lg-5">
                    <div class="collection-panel">
                        <div class="section-heading">
                            <h3>Equipped</h3>
                            <span class="section-count">@character.Equipment.Count</span>
                        </div>
                        @if (character.Equipment.Count == 0)
                        {
                            <p class="empty-state">Nothing is equipped.</p>
                        }
                        else
                        {
                            <div class="inventory-list">
                                @foreach (var item in character.Equipment)
                                {
                                    <div class="inventory-row equipment-row">
                                        <img class="item-icon" src="@(itemIconBaseUrl + item.IconId.ToString("D8") + ".png")" alt="" loading="lazy" />
                                        <span class="equipment-slot">@item.SlotName</span>
                                        <span class="inventory-name">@item.Name</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
                <section class="col-lg-7">
                    <div class="collection-panel">
                        <div class="section-heading">
                            <h3>Inventory</h3>
                            <span class="section-count">@character.Inventory.Count item@(character.Inventory.Count == 1 ? "" : "s")</span>
                        </div>
                        @if (character.Inventory.Count == 0)
                        {
                            <p class="empty-state">No items in this inventory.</p>
                        }
                        else
                        {
                            <div class="inventory-list">
                                @foreach (var item in character.Inventory)
                                {
                                    <div class="inventory-row">
                                        <img class="item-icon" src="@(itemIconBaseUrl + item.IconId.ToString("D8") + ".png")" alt="" loading="lazy" />
                                        <span class="inventory-name">@item.Name</span>
                                        <span class="inventory-quantity">× @item.Quantity</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            </div>
            @foreach (var robo in character.Robos)
            {
                <section class="robo-panel">
                    <div class="section-heading">
                        <div>
                            <span class="eyebrow">Robo</span>
                            <h3>@robo.Name</h3>
                        </div>
                        <span class="section-count">@robo.Equipment.Count equipped</span>
                    </div>
                    <p class="robo-stats">Level @robo.Level <span class="px-1">·</span> @robo.Experience.ToString("N0") / @robo.ExperienceToNextLevel.ToString("N0") XP <span class="px-1">·</span> @robo.Personality</p>
                    @if (robo.Equipment.Count == 0)
                    {
                        <p class="empty-state mt-3">Nothing is equipped.</p>
                    }
                    else
                    {
                        <div class="inventory-list mt-3">
                            @foreach (var item in robo.Equipment)
                            {
                                <div class="inventory-row equipment-row">
                                    <img class="item-icon" src="@(itemIconBaseUrl + item.IconId.ToString("D8") + ".png")" alt="" loading="lazy" />
                                    <span class="equipment-slot">@item.SlotName</span>
                                    <span class="inventory-name">@item.Name</span>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        </section>
    }
}
