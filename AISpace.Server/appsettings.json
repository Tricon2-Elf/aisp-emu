{
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://0.0.0.0:8080"
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "Server": {
        "IPOverride": "localhost",
        "DbOptions": {
            "Provider": "sqlite",
            "ConnectionString": "Data Source=main.db;Cache=Shared;Default Timeout=5"
        },
        "PacketChannelCapacity": 512,
        "MaxConcurrentClients": 32,
        "MaxReceiveFrameSize": 4096,
        "ClientReadTimeoutSeconds": 300,
        "TickRateHz": 10,
        "UseDistributedSessionPresence": false,
        "AuthServer": {
            "Enabled": true,
            "Port": 50050
        },
        "AreaServer": {
            "Enabled": true,
            "Port": 50054
        },
        "MsgServer": {
            "Enabled": true,
            "Port": 50052
        },
        "HealthCheck": {
            "HeartbeatIntervalSeconds": 5,
            "StalenessSeconds": 30
        }
    },
    "Maintenance": {
        "Enabled": false,
        "ScheduledTime": "04:00",
        "WarningMinutes": [30, 15, 10, 5, 1],
        "Message": "Server maintenance in {0} minute(s). You will be disconnected."
    },
    "ApiSettings": {
        "ApiKey": "1mQmb9SvUkATRoVLdVEvkmaKbuufQMVH"
    }
}
