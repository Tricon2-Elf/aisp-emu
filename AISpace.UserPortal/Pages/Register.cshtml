@page "/register"
@model AISpace.UserPortal.Pages.RegisterModel
@{
    ViewData["Title"] = "Register"; Layout = "/Pages/Shared/_Layout.cshtml";
}
<section class="portal-card p-4 p-lg-5">
    <h1 class="portal-title h2">Create account</h1>
    <p class="portal-subtitle mb-4">Use these credentials to sign in to AISpace and this portal.</p>
    <form method="post" class="vstack gap-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div><label asp-for="Input.Username" class="form-label"></label><input asp-for="Input.Username"
                class="form-control" autocomplete="username" /></div>
        <div><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password"
                class="form-control" autocomplete="new-password" /></div>
        <div><label asp-for="Input.ConfirmPassword" class="form-label"></label><input asp-for="Input.ConfirmPassword"
                class="form-control" autocomplete="new-password" /></div>
        <button type="submit" class="btn btn-primary">Create account</button>
    </form>
</section>
