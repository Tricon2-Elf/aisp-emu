@page "/admin/users"
@model aisp.Portal.Pages.Admin.UsersModel
@{
    ViewData["Title"] = "Users";
    Layout = "/Pages/Shared/_Layout.cshtml";
}
<header class="account-hero gap-3 mb-4">
    <div>
        <span class="eyebrow">Administration</span>
        <h1 class="portal-title mb-1">User administration</h1>
        <p class="portal-subtitle mb-0">Review player accounts and game data.</p>
    </div>
    <form method="get" class="search-form" role="search">
        <label class="visually-hidden" for="user-search">Search by username</label>
        <input id="user-search" class="form-control" name="search" value="@Model.Search" placeholder="Search by username" />
        <button class="btn btn-primary px-3" type="submit">Search</button>
    </form>
</header>
@if (Model.Users.Count == 0)
{
    <section class="character-card">
        <p class="empty-state">No users matched your search.</p>
    </section>
}
else
{
    <section class="data-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">User</th>
                        <th>Characters</th>
                        <th>Dolls</th>
                        <th class="pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4"><a class="user-link" href="/admin/users/@user.UserId">@user.Username</a></td>
                            <td class="text-secondary">@(user.CharacterNames.Count == 0 ? "—" : string.Join(", ", user.CharacterNames))</td>
                            <td>@user.RoboCount</td>
                            <td class="pe-4"><span class="status-pill @(user.IsBanned ? "status-banned" : "status-active")">@(user.IsBanned ? "Banned" : "Active")</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}
<nav class="pagination-bar" aria-label="User list pagination">
    <span class="page-indicator">Page @Model.PageNumber</span>
    <div class="d-flex gap-2">
        @if (Model.PageNumber > 1)
        {
            <a class="btn btn-sm btn-ghost" href="?search=@Model.Search&page=@(Model.PageNumber - 1)">Previous</a>
        }
        @if (Model.HasNextPage)
        {
            <a class="btn btn-sm btn-ghost" href="?search=@Model.Search&page=@(Model.PageNumber + 1)">Next</a>
        }
    </div>
</nav>
