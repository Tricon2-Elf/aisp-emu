@{
    var title = ViewData["Title"] as string ?? "aisp-emu Portal";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.HasClaim("portal_admin", "true");
    var homeUrl = isAuthenticated ? (isAdmin ? "/admin/users" : "/account") : "/login";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#11182b" />
    <title>@title · aisp-emu</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/portal.css?v=20260811-4" rel="stylesheet" />
</head>
<body>
    <div class="portal-shell">
        <nav class="portal-nav" aria-label="Primary navigation">
            <div class="container portal-nav-inner">
                <a class="portal-brand" href="@homeUrl" aria-label="aisp-emu portal home">
                    <span>aisp-emu</span>
                    @if (isAdmin)
                    {
                        <span class="portal-context">Admin</span>
                    }
                </a>
                <div class="portal-nav-actions">
                    @if (isAuthenticated)
                    {
                        <span class="portal-user d-none d-sm-inline">@User.Identity?.Name</span>
                        <form method="post" action="/logout">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-ghost" type="submit">Sign out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-ghost" href="/login">Sign in</a>
                    }
                </div>
            </div>
        </nav>
        <main class="container portal-main">
            @RenderBody()
        </main>
    </div>
    <script src="/portal.js?v=20260810-1" defer></script>
</body>
</html>
